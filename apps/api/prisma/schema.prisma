generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum StaffRole {
  SUPER_ADMIN
  ADMIN
  MODERATOR
  EDITOR
  ANALYST
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum IncidentStatus {
  NEW
  UNDER_REVIEW
  ACTIONED
  CLOSED
  REJECTED
}

enum SubmissionLanguage {
  ha
  en
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
}

enum PreferredContactMethod {
  PHONE
  EMAIL
}

enum AttachmentStatus {
  QUARANTINED
  AVAILABLE
  REJECTED
}

enum AttachmentAccessType {
  CONTENT_ACCESS
}

enum AttachmentReviewSource {
  MANUAL
  SCANNER
}

enum NewsArticleStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
}

model User {
  id                  String     @id @default(uuid()) @db.Uuid
  /// Must be stored in normalized lowercase form by the future identity service.
  email               String     @unique @db.VarChar(320)
  passwordHash        String     @map("password_hash")
  displayName         String     @map("display_name")
  role                StaffRole
  status              UserStatus @default(ACTIVE)
  lastLoginAt         DateTime?  @map("last_login_at") @db.Timestamptz(3)
  failedLoginAttempts Int        @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?  @map("locked_until") @db.Timestamptz(3)
  passwordChangedAt   DateTime?  @map("password_changed_at") @db.Timestamptz(3)
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  assignedIncidents     Incident[]                         @relation("IncidentAssignee")
  incidentStatusChanges IncidentStatusHistory[]            @relation("IncidentStatusChangedBy")
  assignmentsFrom       IncidentAssignmentHistory[]        @relation("IncidentAssignmentFromUser")
  assignmentsTo         IncidentAssignmentHistory[]        @relation("IncidentAssignmentToUser")
  assignmentChanges     IncidentAssignmentHistory[]        @relation("IncidentAssignmentChangedBy")
  contactAccesses       IncidentContactAccessHistory[]
  authoredIncidentNotes IncidentStaffNote[]                @relation("IncidentStaffNoteAuthor")
  deletedIncidentNotes  IncidentStaffNote[]                @relation("IncidentStaffNoteDeletedBy")
  noteRevisionChanges   IncidentStaffNoteRevision[]        @relation("IncidentStaffNoteRevisionChangedBy")
  attachmentAccesses    IncidentAttachmentAccessHistory[]
  attachmentReviews     IncidentAttachmentSecurityReview[]
  authoredNewsArticles  NewsArticle[]                      @relation("NewsArticleAuthor")
  newsStatusChanges     NewsArticleStatusHistory[]         @relation("NewsArticleStatusActor")
  sessions              StaffSession[]

  @@index([role, status])
  @@map("staff_users")
}

model NewsCategory {
  id            String   @id @default(uuid()) @db.Uuid
  code          String   @unique @db.VarChar(40)
  slug          String   @unique @db.VarChar(80)
  nameHa        String   @map("name_ha") @db.VarChar(160)
  nameEn        String   @map("name_en") @db.VarChar(160)
  descriptionHa String?  @map("description_ha") @db.VarChar(500)
  descriptionEn String?  @map("description_en") @db.VarChar(500)
  displayOrder  Int      @map("display_order")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  articles NewsArticle[]

  @@index([isActive, displayOrder])
  @@map("news_categories")
}

model NewsArticle {
  id                   String            @id @default(uuid()) @db.Uuid
  slug                 String            @unique @db.VarChar(100)
  status               NewsArticleStatus @default(DRAFT)
  authorId             String            @map("author_id") @db.Uuid
  categoryId           String            @map("category_id") @db.Uuid
  titleHa              String            @map("title_ha") @db.VarChar(180)
  summaryHa            String            @map("summary_ha") @db.VarChar(500)
  bodyHa               String            @map("body_ha") @db.Text
  titleEn              String?           @map("title_en") @db.VarChar(180)
  summaryEn            String?           @map("summary_en") @db.VarChar(500)
  bodyEn               String?           @map("body_en") @db.Text
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  submittedForReviewAt DateTime?         @map("submitted_for_review_at") @db.Timestamptz(3)
  publishedAt          DateTime?         @map("published_at") @db.Timestamptz(3)
  archivedAt           DateTime?         @map("archived_at") @db.Timestamptz(3)

  author        User                       @relation("NewsArticleAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  category      NewsCategory               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  statusHistory NewsArticleStatusHistory[]

  @@index([status, updatedAt])
  @@index([authorId, updatedAt])
  @@index([categoryId])
  @@index([status, categoryId, publishedAt])
  @@index([createdAt])
  @@index([publishedAt])
  @@map("news_articles")
}

model NewsArticleStatusHistory {
  id         String             @id @default(uuid()) @db.Uuid
  articleId  String             @map("article_id") @db.Uuid
  fromStatus NewsArticleStatus? @map("from_status")
  toStatus   NewsArticleStatus  @map("to_status")
  actorId    String             @map("actor_id") @db.Uuid
  reason     String?            @db.VarChar(1000)
  createdAt  DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  article NewsArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  actor   User        @relation("NewsArticleStatusActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([articleId, createdAt])
  @@index([actorId, createdAt])
  @@map("news_article_status_history")
}

model StaffSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  lastUsedAt DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt, revokedAt])
  @@map("staff_sessions")
}

model IncidentCategory {
  id            String   @id @default(uuid()) @db.Uuid
  nameHa        String   @unique @map("name_ha") @db.VarChar(160)
  nameEn        String   @unique @map("name_en") @db.VarChar(160)
  descriptionHa String?  @map("description_ha") @db.VarChar(500)
  descriptionEn String?  @map("description_en") @db.VarChar(500)
  isActive      Boolean  @default(true) @map("is_active")
  displayOrder  Int      @default(0) @map("display_order")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  incidents Incident[]

  @@index([isActive, displayOrder])
  @@map("incident_categories")
}

model Incident {
  id                    String             @id @default(uuid()) @db.Uuid
  internalCaseId        String             @unique @map("internal_case_id") @db.VarChar(17)
  categoryId            String             @map("category_id") @db.Uuid
  description           String             @db.Text
  incidentDate          DateTime?          @map("incident_date") @db.Date
  incidentTime          DateTime?          @map("incident_time") @db.Time(0)
  locationDescription   String?            @map("location_description") @db.VarChar(500)
  state                 String?            @db.VarChar(100)
  lga                   String?            @db.VarChar(100)
  latitude              Decimal?           @db.Decimal(9, 6)
  longitude             Decimal?           @db.Decimal(10, 6)
  severity              IncidentSeverity
  status                IncidentStatus     @default(NEW)
  submissionLanguage    SubmissionLanguage @map("submission_language")
  assignedToUserId      String?            @map("assigned_to_user_id") @db.Uuid
  duplicateOfIncidentId String?            @map("duplicate_of_incident_id") @db.Uuid
  submittedAt           DateTime           @default(now()) @map("submitted_at") @db.Timestamptz(3)
  updatedAt             DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  closedAt              DateTime?          @map("closed_at") @db.Timestamptz(3)

  category                IncidentCategory                   @relation(fields: [categoryId], references: [id])
  assignedToUser          User?                              @relation("IncidentAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  duplicateOfIncident     Incident?                          @relation("IncidentDuplicates", fields: [duplicateOfIncidentId], references: [id], onDelete: SetNull)
  duplicates              Incident[]                         @relation("IncidentDuplicates")
  contact                 IncidentContact?
  statusHistory           IncidentStatusHistory[]
  assignmentHistory       IncidentAssignmentHistory[]
  contactAccessHistory    IncidentContactAccessHistory[]
  staffNotes              IncidentStaffNote[]
  attachments             IncidentAttachment[]
  attachmentAccessHistory IncidentAttachmentAccessHistory[]
  attachmentReviews       IncidentAttachmentSecurityReview[]

  @@index([categoryId, status])
  @@index([status, severity, submittedAt])
  @@index([assignedToUserId])
  @@index([duplicateOfIncidentId])
  @@map("incidents")
}

model IncidentContact {
  id                      String                 @id @default(uuid()) @db.Uuid
  incidentId              String                 @unique @map("incident_id") @db.Uuid
  name                    String?                @db.Text
  phone                   String?                @db.Text
  email                   String?                @db.Text
  preferredContactMethod  PreferredContactMethod @map("preferred_contact_method")
  safeContactInstructions String?                @map("safe_contact_instructions") @db.Text
  consentToContact        Boolean                @map("consent_to_contact")
  createdAt               DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)

  incident      Incident                       @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  accessHistory IncidentContactAccessHistory[]

  @@map("incident_contacts")
}

model IncidentStatusHistory {
  id              String          @id @default(uuid()) @db.Uuid
  incidentId      String          @map("incident_id") @db.Uuid
  fromStatus      IncidentStatus? @map("from_status")
  toStatus        IncidentStatus  @map("to_status")
  changedByUserId String?         @map("changed_by_user_id") @db.Uuid
  comment         String?         @db.VarChar(1000)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  incident      Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  changedByUser User?    @relation("IncidentStatusChangedBy", fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([incidentId, createdAt])
  @@index([changedByUserId])
  @@map("incident_status_history")
}

model IncidentAssignmentHistory {
  id              String   @id @default(uuid()) @db.Uuid
  incidentId      String   @map("incident_id") @db.Uuid
  fromUserId      String?  @map("from_user_id") @db.Uuid
  toUserId        String?  @map("to_user_id") @db.Uuid
  changedByUserId String   @map("changed_by_user_id") @db.Uuid
  comment         String?  @db.VarChar(1000)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  incident      Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  fromUser      User?    @relation("IncidentAssignmentFromUser", fields: [fromUserId], references: [id], onDelete: SetNull)
  toUser        User?    @relation("IncidentAssignmentToUser", fields: [toUserId], references: [id], onDelete: SetNull)
  changedByUser User     @relation("IncidentAssignmentChangedBy", fields: [changedByUserId], references: [id], onDelete: Restrict)

  @@index([incidentId, createdAt])
  @@index([fromUserId])
  @@index([toUserId])
  @@index([changedByUserId])
  @@map("incident_assignment_history")
}

model IncidentContactAccessHistory {
  id               String   @id @default(uuid()) @db.Uuid
  incidentId       String   @map("incident_id") @db.Uuid
  contactId        String   @map("contact_id") @db.Uuid
  accessedByUserId String   @map("accessed_by_user_id") @db.Uuid
  reason           String   @db.VarChar(1000)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  incident   Incident        @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  contact    IncidentContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  accessedBy User            @relation(fields: [accessedByUserId], references: [id], onDelete: Restrict)

  @@index([incidentId, createdAt])
  @@index([accessedByUserId, createdAt])
  @@map("incident_contact_access_history")
}

model IncidentStaffNote {
  id              String    @id @default(uuid()) @db.Uuid
  incidentId      String    @map("incident_id") @db.Uuid
  authorUserId    String    @map("author_user_id") @db.Uuid
  body            String    @db.Text
  version         Int       @default(1)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  editedAt        DateTime? @map("edited_at") @db.Timestamptz(3)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedByUserId String?   @map("deleted_by_user_id") @db.Uuid
  deletionReason  String?   @map("deletion_reason") @db.VarChar(1000)

  incident  Incident                    @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  author    User                        @relation("IncidentStaffNoteAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  deletedBy User?                       @relation("IncidentStaffNoteDeletedBy", fields: [deletedByUserId], references: [id], onDelete: SetNull)
  revisions IncidentStaffNoteRevision[]

  @@index([incidentId, createdAt])
  @@index([authorUserId, createdAt])
  @@index([deletedAt])
  @@map("incident_staff_notes")
}

model IncidentStaffNoteRevision {
  id              String   @id @default(uuid()) @db.Uuid
  noteId          String   @map("note_id") @db.Uuid
  revisionNumber  Int      @map("revision_number")
  body            String   @db.Text
  changedByUserId String   @map("changed_by_user_id") @db.Uuid
  changeReason    String?  @map("change_reason") @db.VarChar(1000)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  note      IncidentStaffNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  changedBy User              @relation("IncidentStaffNoteRevisionChangedBy", fields: [changedByUserId], references: [id], onDelete: Restrict)

  @@unique([noteId, revisionNumber])
  @@index([noteId, createdAt])
  @@index([changedByUserId, createdAt])
  @@map("incident_staff_note_revisions")
}

model IncidentAttachment {
  id               String           @id @default(uuid()) @db.Uuid
  incidentId       String           @map("incident_id") @db.Uuid
  objectKey        String           @unique @map("object_key") @db.VarChar(255)
  originalFilename String           @map("original_filename") @db.VarChar(255)
  verifiedMimeType String           @map("verified_mime_type") @db.VarChar(80)
  sizeBytes        Int              @map("size_bytes")
  sha256           String           @db.Char(64)
  width            Int?
  height           Int?
  pageCount        Int?             @map("page_count")
  status           AttachmentStatus @default(QUARANTINED)
  uploadedAt       DateTime         @default(now()) @map("uploaded_at") @db.Timestamptz(3)
  availableAt      DateTime?        @map("available_at") @db.Timestamptz(3)
  rejectedAt       DateTime?        @map("rejected_at") @db.Timestamptz(3)
  rejectionReason  String?          @map("rejection_reason") @db.VarChar(1000)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  incident       Incident                          @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  accessHistory  IncidentAttachmentAccessHistory[]
  securityReview IncidentAttachmentSecurityReview?

  @@index([incidentId, uploadedAt])
  @@index([status, uploadedAt])
  @@index([sha256])
  @@map("incident_attachments")
}

model IncidentAttachmentAccessHistory {
  id               String               @id @default(uuid()) @db.Uuid
  attachmentId     String               @map("attachment_id") @db.Uuid
  incidentId       String               @map("incident_id") @db.Uuid
  accessedByUserId String               @map("accessed_by_user_id") @db.Uuid
  accessType       AttachmentAccessType @default(CONTENT_ACCESS) @map("access_type")
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  attachment IncidentAttachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
  incident   Incident           @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  accessedBy User               @relation(fields: [accessedByUserId], references: [id], onDelete: Restrict)

  @@index([attachmentId, createdAt])
  @@index([accessedByUserId, createdAt])
  @@index([incidentId, createdAt])
  @@map("incident_attachment_access_history")
}

model IncidentAttachmentSecurityReview {
  id               String                 @id @default(uuid()) @db.Uuid
  attachmentId     String                 @unique @map("attachment_id") @db.Uuid
  incidentId       String                 @map("incident_id") @db.Uuid
  reviewedByUserId String?                @map("reviewed_by_user_id") @db.Uuid
  decision         AttachmentStatus
  reason           String                 @db.VarChar(1000)
  reviewSource     AttachmentReviewSource @map("review_source")
  scannerEngine    String?                @map("scanner_engine") @db.VarChar(160)
  scannerVersion   String?                @map("scanner_version") @db.VarChar(100)
  scannerSignature String?                @map("scanner_signature") @db.VarChar(255)
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)

  attachment IncidentAttachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
  incident   Incident           @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  reviewedBy User?              @relation(fields: [reviewedByUserId], references: [id], onDelete: Restrict)

  @@index([attachmentId, createdAt])
  @@index([incidentId, createdAt])
  @@index([reviewedByUserId, createdAt])
  @@map("incident_attachment_security_reviews")
}
