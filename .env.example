NODE_ENV=development
DEPLOYMENT_ENV=local
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api
NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=postgresql://garkuwa:garkuwa_dev_password@localhost:5432/garkuwa?schema=public
CONTACT_DATA_ENCRYPTION_KEY=replace_with_canonical_base64_for_exactly_32_random_bytes
STAFF_SESSION_COOKIE_SECURE=false
TRUST_PROXY=false
LOG_LEVEL=log
INCIDENT_STORAGE_DRIVER=filesystem
INCIDENT_STORAGE_FILESYSTEM_ROOT=.var/incident-uploads
NEWSROOM_MEDIA_FILESYSTEM_ROOT=.var/newsroom-media
ALLOW_PRODUCTION_FILESYSTEM_STORAGE=false
S3_ENDPOINT=https://private-object-storage.example.invalid
S3_REGION=us-east-1
S3_BUCKET=garkuwa-private-incidents
S3_ACCESS_KEY_ID=replace_with_private_storage_access_key
S3_SECRET_ACCESS_KEY=replace_with_private_storage_secret_key
S3_FORCE_PATH_STYLE=false
S3_SERVER_SIDE_ENCRYPTION=AES256
S3_KMS_KEY_ID=
DEPENDENCY_CHECK_TIMEOUT_MS=5000
STORAGE_OPERATION_TIMEOUT_MS=30000
SHUTDOWN_GRACE_PERIOD_MS=30000
POSTGRES_DB=garkuwa
POSTGRES_USER=garkuwa
POSTGRES_PASSWORD=garkuwa_dev_password
POSTGRES_PORT=5432
